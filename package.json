{
  "name": "soundings-homepage",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "packageManager": "yarn@4.18.0",
  "scripts": {
    "dev": "vitepress dev",
    "build": "vitepress build",
    "preview": "vitepress preview",
    "sync": "node scripts/sync.mjs",
    "sync:check": "node scripts/sync.mjs --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "ncu": "NO_UPDATE_NOTIFIER=1 ncu",
    "ncu:update": "NO_UPDATE_NOTIFIER=1 ncu -u",
    "check": "yarn check:types && yarn check:data && yarn check:vocab && yarn check:i18n && yarn check:docs",
    "check:data": "node scripts/check-data.mjs",
    "check:types": "tsc --noEmit",
    "check:vocab": "node scripts/check-vocab.mjs",
    "check:i18n": "node scripts/check-i18n-parity.mjs",
    "check:docs": "node scripts/check-doc-links.mjs",
    "verify": "yarn check && yarn test && yarn build"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@types/node": "^26.4.1",
    "@vitejs/plugin-vue": "^6",
    "@vue/compiler-dom": "^3.5.42",
    "@vue/test-utils": "^2.5",
    "jsdom": "^30",
    "npm-check-updates": "^23.1.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitepress": "^1.6.4",
    "vitest": "^5",
    "vue": "^3.5.42"
  }
}
