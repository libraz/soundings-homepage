ms/11-06-parked.json","keys":["parameters[address=40 03 0C].default"],"values":[40]},{"file":"data/units/roland-sc8850-01/efx-params/11-06.json","within":"efx-params/11-06.json","keys":["parameters[address=40 03 0C].default"],"values":[40]},{"file":"data/units/roland-sc8850-01/efx-params/11-07-parked.json","within":"efx-params/11-07-parked.json","keys":["parameters[address=40 03 03].default","parameters[address=40 03 04].default"],"values":[36,16]},{"file":"data/units/roland-sc8850-01/efx-params/11-07.json","within":"efx-params/11-07.json","keys":["parameters[address=40 03 03].default","parameters[address=40 03 04].default"],"values":[36,16]},{"file":"data/units/roland-sc8850-01/efx-params/11-08-parked.json","within":"efx-params/11-08-parked.json","keys":["parameters[address=40 03 03].default","parameters[address=40 03 04].default"],"values":[36,16]},{"file":"data/units/roland-sc8850-01/efx-params/11-08.json","within":"efx-params/11-08.json","keys":["parameters[address=40 03 03].default","parameters[address=40 03 04].default"],"values":[36,16]}],"documentRows":[{"file":"documents/roland-sc-8850-owners-manual-en/effect-list.json","rows":["every row whose setting is printed in three parts, the middle of which is the default, over all sixty-five types"]},{"file":"documents/roland-sc-8850-owners-manual-en/value-conversion.json","rows":["every column a parameter's value cell refers to, for the parameters whose byte does not carry their setting"]}],"eraPriors":[],"community":[]},"alternatives":[{"reading":"What the records call a default is not what the unit powers up holding, but whatever the run before them left at that address.","candidate":null,"standing":false,"ruledOutBy":"It would have to be wrong the same way at every one of these parameters, and wrong in the direction of a page nothing in those runs had read. The records were written over several sessions and a type whose parameters share addresses with another type returns each type's own value at them, which is